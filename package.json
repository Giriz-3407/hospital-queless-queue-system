{
  "name": "queueless-smart-hospital",
  "version": "1.0.0",
  "description": "Queueless Smart Hospital Queue Management System",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && python run.py",
    "dev:backend:win": "cd backend && py run.py",
    "build": "npm --prefix frontend run build",
    "test:backend": "cd backend && pytest",
    "test:backend:win": "cd backend && py -m pytest",
    "lint:frontend": "npm --prefix frontend run lint",
    "install:all": "npm install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "hospital",
    "queue-management",
    "virtual-queue",
    "react",
    "flask",
    "mongodb"
  ],
  "author": "Smart Hospital Team",
  "license": "MIT"
}
