# MongoDB Configuration (Supports local mongod or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=queueless_hospital

# Application Secrets
SECRET_KEY=replace-with-a-secure-random-secret
JWT_SECRET_KEY=replace-with-a-separate-secure-random-secret
ACCESS_TOKEN_EXPIRES_MINUTES=30

# CORS & Server Configuration
FRONTEND_ORIGIN=http://localhost:5173
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

# QR Public Base URL (Single source of truth for department QR destinations)
# Temporary reachable test destination:
QR_PUBLIC_BASE_URL=https://httpbin.org/anything
# Production destination placeholder (when custom domain is available):
# QR_PUBLIC_BASE_URL=https://queueless.hospital.org
